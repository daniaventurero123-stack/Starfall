const EXO_C = 32, EXO_N = 14, EXO_RAMP = 420;   // celda (px) de la rejilla de distancias, radio de búsqueda (celdas) y largo del degradado (px)
function exoGrid() {   // w = 0 en zona 1 y zona 3; sube dentro de la zona 2 desde el borde con la zona 1 y baja hacia el borde con la zona 3
  const P = CFG.CPX, sx = WRECK_X, sy = WRECK_Y + 140, R = P * CFG.ZONE_R, C = EXO_C, per = P / C, GW = Math.ceil(CFG.PX_W / C), GH = Math.ceil(CFG.PX_H / C), M = EXO_N, CW = CFG.CW, CH = CFG.CH;
