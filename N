#lab .cx .top{flex:none;display:flex;justify-content:space-between;align-items:center;padding:6px 10px;font-size:.8em;letter-spacing:.14em;color:#74ecff;background:#06194a;box-shadow:inset 0 0 0 2px #14121f,inset 0 0 0 4px #74ecff}
#lab .cx .top b{color:#ffcf6f}
#lab .cx .bk{flex:1;min-height:0;overflow-y:auto;padding:4px 8px 8px;background:#06194a;box-shadow:inset 0 0 0 2px #14121f,inset 0 0 0 4px #0c3a8c}
#lab .cx h4{margin:8px 0 6px;padding-bottom:3px;display:flex;justify-content:space-between;font-size:.74em;font-weight:700;letter-spacing:.14em;color:#74ecff;border-bottom:2px solid #0c3a8c}
#lab .cx h4 i{font-style:normal;color:#ffcf6f}
#lab .cx .gd{display:grid;grid-template-columns:repeat(auto-fill,minmax(76px,1fr));gap:7px}
#lab .cx .it{box-sizing:border-box;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;gap:4px;min-height:66px;padding:6px 3px 5px;background:#0a1a4a;box-shadow:inset 0 0 0 2px #14121f,inset 0 0 0 4px #3df07a}
#lab .cx .it img{width:32px;height:32px;image-rendering:pixelated}
#lab .cx .it span{font-size:.62em;letter-spacing:.03em;text-align:center;line-height:1.15;color:#d8f8ff;overflow-wrap:anywhere}
