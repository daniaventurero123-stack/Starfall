  polvo:   { ramp:['#4d4559','#554c62','#5d546a','#665c73','#6f657c'], fleck:'#8f81ab', crack:['#241f31', .45], vein:['#79a9cc', .35] },
  grava:   { ramp:['#807b8e','#898497','#928da0','#9b96a9','#a5a0b2'], fleck:'#c4bed4', crack:['#4a4560', .35] },
  hielo:   { ramp:['#7aa0bb','#86aac4','#92b5cd','#9fc0d6','#aecbe0'], fleck:'#e6f3fb', crack:['#eaf5fc', .5], nogl:1 },
  // Césped alienígena: base violeta/púrpura/lavanda; blade = [punta, tallo, hueco] para las briznas de 2 texels
  cesped:  { ramp:['#4b3b72','#58447f','#66518d','#75619b','#8a79b0'], fleck:'#c3b4e6', blade:['#b4a4dc','#7a66ae','#33275a'], nogl:1 },
  escombros:{ ramp:['#3f3d52','#46445a','#4d4b63','#55536c','#5e5c76'], fleck:'#7f7c9e', crack:['#1e1c2c', .4] },
  agua:    { ramp:['#2a6fa3','#2f78ad','#3582b6','#3c8cc0','#44a0cc'], nogl:1 },
  basalto: { ramp:['#464461','#4d4b68','#555370','#5d5b78','#666481'], h:1, wall:'#2b2a3c', base:'#1c1b29', edge:'#7a7898' }
};
for (const k in TILES) { const T = TILES[k]; T.rgb = T.ramp.map(rgb); if (T.fleck) T.fk = rgb(T.fleck); if (T.blade) T.bl = T.blade.map(rgb);
