  box-shadow:0 -2px 0 #74ecff,0 2px 0 #74ecff,-2px 0 0 #74ecff,2px 0 0 #74ecff,inset 5px 0 0 #74ffb0,inset -2px -2px 0 rgba(0,0,12,.4),0 6px 0 #06214f,0 0 14px #2f8cffaa;padding-left:20px}
