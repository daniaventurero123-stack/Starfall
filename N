#lab .cx .it.lk span{color:#5f86c8}
/* ===== Mesa de construcción (pixel art): riel de categorías · lista de recetas · detalle con materiales · barra de mochila ===== */
#lab.cons .lbc{width:min(100%,820px)}
#lab .cn{display:grid;grid-template-columns:46px minmax(0,.9fr) minmax(0,1.3fr);grid-template-rows:minmax(0,1fr) auto;gap:8px;height:min(calc(100vh - 100px),400px);min-height:210px}
#lab .cn .rail{display:flex;flex-direction:column;gap:6px;min-height:0;overflow-y:auto;padding:2px}
#lab .cn .cat{position:relative;flex:none;display:grid;place-items:center;height:40px;cursor:pointer;background:#06194a;opacity:.8;box-shadow:inset 0 0 0 2px #14121f,inset 0 0 0 4px #0c3a8c;-webkit-tap-highlight-color:transparent}
#lab .cn .cat img{width:32px;height:32px;image-rendering:pixelated}
#lab .cn .cat.on{opacity:1;background:#0c3a8c;box-shadow:inset 0 0 0 2px #14121f,inset 0 0 0 4px #74ecff}
#lab .cn .cat i{position:absolute;top:1px;right:2px;min-width:1.2em;padding:0 2px;font-style:normal;font-size:.7em;line-height:1.3em;text-align:center;color:#06194a;background:#3df07a;box-shadow:0 0 0 1px #14121f}
#lab .cn .lst,#lab .cn .dt{display:flex;flex-direction:column;gap:6px;min-height:0;min-width:0;padding:8px;background:#06194a;box-shadow:inset 0 0 0 2px #14121f,inset 0 0 0 4px #0c3a8c}
#lab .cn .dt{box-shadow:inset 0 0 0 2px #14121f,inset 0 0 0 4px #74ecff}
#lab .cn .cap{display:flex;align-items:center;justify-content:space-between;gap:6px;font-size:.74em;letter-spacing:.14em;color:#74ecff;padding-bottom:4px;border-bottom:2px solid #0c3a8c}
#lab .cn .up{display:inline-flex;align-items:center;gap:4px;flex:none;padding:2px 6px;cursor:pointer;font-size:.95em;letter-spacing:.05em;color:#3a2606;background:#ffc23d;box-shadow:inset 0 2px 0 #fff0a8,inset 0 -2px 0 #a8741f,0 0 0 2px #14121f}
