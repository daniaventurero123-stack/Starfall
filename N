const joyEl = document.getElementById('joy'), knob = joyEl.firstElementChild, joy = { x: 0, y: 0, id: null };
const setTouch = () => document.body.classList.add('touch');
if (matchMedia('(pointer:coarse)').matches || navigator.maxTouchPoints > 0) setTouch();
addEventListener('pointerdown', e => { if (e.pointerType === 'touch') setTouch(); }, { passive: true });
function joyMove(e) {
  const r = joyEl.getBoundingClientRect(), R = r.width / 2 - 12, KR = r.width / 2 - 30;   // R: recorrido del dedo; KR: hasta dónde se dibuja el botón (siempre dentro del aro)
  let dx = e.clientX - (r.left + r.width / 2), dy = e.clientY - (r.top + r.height / 2); const d = Math.hypot(dx, dy) || 1e-6;
  const m = Math.min(1, d / R), ux = dx / d, uy = dy / d;
  knob.style.transform = `translate(${ux * Math.min(d, R) * KR / R}px,${uy * Math.min(d, R) * KR / R}px)`;
  const DZ = .12, s = m < DZ ? 0 : (m - DZ) / (1 - DZ);   // zona muerta que se descuenta: la velocidad sube suave desde 0, sin salto al empezar
  joy.x = ux * s; joy.y = uy * s;
}
function joyEnd(e) { if (e && e.pointerId !== joy.id) return; joy.id = null; joy.x = joy.y = 0; knob.style.transform = ''; }
joyEl.addEventListener('pointerdown', e => { e.preventDefault(); try { window.focus(); } catch (x) {} joy.id = e.pointerId; try { joyEl.setPointerCapture(e.pointerId); } catch (x) {} joyMove(e); });
joyEl.addEventListener('pointermove', e => { if (e.pointerId === joy.id) { e.preventDefault(); joyMove(e); } });
joyEl.addEventListener('pointerup', joyEnd); joyEl.addEventListener('pointercancel', joyEnd); joyEl.addEventListener('lostpointercapture', joyEnd);   // lostpointercapture: si el sistema te quita el dedo, el astronauta no se queda caminando solo
document.addEventListener('visibilitychange', () => { if (document.hidden) joyEnd(); });
