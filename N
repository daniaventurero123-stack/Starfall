#lab .cn .up.done{cursor:default;color:#06361c;background:#3df07a;box-shadow:inset 0 2px 0 #b6ffd0,inset 0 -2px 0 #1d9a52,0 0 0 2px #14121f}
#lab .cn .tiles{flex:1;min-height:0;overflow-y:auto;display:grid;grid-template-columns:repeat(auto-fill,minmax(62px,1fr));gap:7px;align-content:start;padding:5px}
#lab .cn .tl{box-sizing:border-box;position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;min-height:58px;padding:5px 2px 4px;cursor:pointer;background:#0a1a4a;opacity:.72;box-shadow:inset 0 0 0 2px #14121f,inset 0 0 0 4px #0c3a8c;-webkit-tap-highlight-color:transparent}
#lab .cn .tl img{width:28px;height:28px}
#lab .cn .tl span{font-size:.7em;letter-spacing:.03em;text-align:center;line-height:1.15;color:#d8f8ff}
#lab .cn .tl.can{opacity:1;box-shadow:inset 0 0 0 2px #14121f,inset 0 0 0 4px #3df07a}
#lab .cn .tl.own{opacity:.9;box-shadow:inset 0 0 0 2px #14121f,inset 0 0 0 4px #ffcf6f}
#lab .cn .tl.on{opacity:1;background:#0c3a8c;box-shadow:inset 0 0 0 2px #14121f,inset 0 0 0 4px #74ecff,0 0 0 2px #14121f,0 0 0 4px #74ecff}
#lab .cn .tl .b{position:absolute;top:3px;right:3px;min-width:1.2em;padding:0 2px;font-style:normal;font-size:.7em;line-height:1.3em;text-align:center;color:#06194a;background:#3df07a;box-shadow:0 0 0 1px #14121f}
#lab .cn .tl .b.st{background:#ffcf6f}
#lab .cn .tl .b.own{background:#ffcf6f}
#lab .cn .dsc{flex:1;min-height:0;overflow-y:auto;display:flex;flex-direction:column;gap:6px;padding-right:2px}
#lab .cn .hd2{display:grid;grid-template-columns:52px minmax(0,1fr);gap:8px;align-items:center}
#lab .cn .pv{width:52px;height:52px;display:grid;place-items:center;background-color:#06194a;background-image:linear-gradient(#0c3a8c 1px,transparent 1px),linear-gradient(90deg,#0c3a8c 1px,transparent 1px);background-size:6px 6px;box-shadow:inset 0 0 0 2px #14121f,inset 0 0 0 4px #74ecff}
#lab .cn .pv img{width:34px;height:34px}
#lab .cn .dt.flash .pv{animation:cnfl .5s steps(5)}
@keyframes cnfl{0%{filter:brightness(3)}100%{filter:brightness(1)}}
#lab .cn .nm{font-size:.95em;line-height:1.2;color:#74ecff}
#lab .cn .nm i{display:inline-block;margin-left:6px;padding:1px 4px;font-style:normal;font-size:.7em;color:#06194a;background:#ffcf6f;vertical-align:middle}
#lab .cn .ds{margin-top:2px;font-size:.76em;line-height:1.3;text-transform:none;color:#8cb4ff}
#lab .cn .igs{display:grid;grid-template-columns:repeat(auto-fit,minmax(124px,1fr));gap:5px}
#lab .cn .ig{display:grid;grid-template-columns:28px minmax(0,1fr);gap:6px;align-items:center;padding:3px 4px;background:rgba(47,140,255,.1)}
#lab .cn .ig .bx{width:28px;height:28px;display:grid;place-items:center;background:#0a1a4a;box-shadow:inset 0 0 0 2px #14121f,inset 0 0 0 3px #ff6a5a}
