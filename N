  for (let j = 0; j < CH; j++) for (let i = 0; i < CW; i++) { if (A[j * CW + i]) { B[j * CW + i] = 1; continue; } for (let dj = -ZONE2_R; dj <= ZONE2_R && !B[j * CW + i]; dj++) for (let di = -ZONE2_R; di <= ZONE2_R; di++) { const x = i + di, y = j + dj; if (x >= 0 && y >= 0 && x < CW && y < CH && A[y * CW + x]) { B[j * CW + i] = 1; break; } } }
  const inA = (gx, gy) => A[Math.min(CH - 1, (gy / per) | 0) * CW + Math.min(CW - 1, (gx / per) | 0)] === 1, inB = (gx, gy) => B[Math.min(CH - 1, (gy / per) | 0) * CW + Math.min(CW - 1, (gx / per) | 0)] === 1;
  const sd = (pred, gx, gy) => {   // distancia con signo (px) al borde de una región: negativa dentro
    const ins = pred(gx, gy); let d = M + 1;
    for (let dy = -M; dy <= M; dy++) for (let dx = -M; dx <= M; dx++) { const q = Math.hypot(dx, dy); if (q < d && pred(Math.max(0, gx + dx), Math.max(0, gy + dy)) !== ins) d = q; }
