  #lab .mnp .nt{font-size:.66em;min-height:1.1em}
}
#lab .mnp .nt{font-size:.72em;min-height:1.3em;text-align:center;color:#ffcf6f}
#lab .msc::before,#lab .msc::after{content:'';position:absolute;width:14px;height:14px;border:0 solid #d8f8ff}
#lab .msc::before{left:12px;top:12px;border-width:3px 0 0 3px}
#lab .msc::after{right:12px;bottom:12px;border-width:0 3px 3px 0}
/* ===== Libro de objetos: botón en la cabecera de la mesa de construcción y lista de recursos, objetos y armas ===== */
