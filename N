#lab .cn .ch img{width:64%;height:64%}
#lab .cn .ch b{position:absolute;right:2px;bottom:0;font-size:.7em;color:#fff;text-shadow:1px 1px 0 #14121f,-1px 1px 0 #14121f,1px -1px 0 #14121f,-1px -1px 0 #14121f}
#lab .cn .emp{font-size:.74em;color:#5f86c8}
.ov .hd .upb{flex:none;box-sizing:border-box;width:1.9em;height:1.9em;min-width:0;min-height:0;aspect-ratio:1;padding:0;margin:0;line-height:0;display:grid;place-items:center;align-self:center;background:rgba(3,14,50,.75);border:0;box-shadow:inset 0 0 0 1.5px #ffc23d,0 0 7px rgba(255,194,61,.55);cursor:pointer;-webkit-tap-highlight-color:transparent}
