const GROUND = BIOMES.filter(b => !TILES[b.tile].h && b.tile !== 'agua');   // materiales para el suelo llano
const BORDER = { name:'Muro del borde', tile:'basalto' };
// Lagos: agua por profundidad (poco profunda → profunda), piedra de la orilla y cara de la pared (de arriba abajo)
const RING = 2.6;   // ancho de la orilla rocosa, en bloques
const WATER = [['#5fc7c4','#6fd2cb','#82dcd2'], ['#3a9fc0','#42aacb','#4cb4d3'], ['#2a6fa3','#2f78ad','#3582b6'], ['#1c4a82','#204f8a','#255893']].map(l => l.map(rgb));
const STONE = ['#5a566c','#666279','#726e86','#7f7b93','#8c88a0'].map(rgb);
