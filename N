  #lab .mnp .mcol{gap:3px}
  #lab .mnp .mh{padding-bottom:2px;font-size:.72em}
  #lab .mnp .mr{font-size:.78em;padding:1px 4px;gap:6px}
  #lab .mnp .mr img{width:1.5em;height:1.5em}
  #lab .mnp .mg{grid-template-columns:repeat(6,1fr);gap:4px}
  #lab .mnp .ms{aspect-ratio:1}
  #lab .mnp .ms em{font-size:.72em;right:3px}
  #lab .mnp .mhint{display:none}
  #lab .mnp .mnext{font-size:.68em}
