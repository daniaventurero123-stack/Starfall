#lab .cn .ig .tx{min-width:0;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:0 4px;align-items:center}
#lab .cn .ig b{font-size:.7em;color:#d8f8ff;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
#lab .cn .ig em{font-style:normal;font-size:.78em}
#lab .cn .ig.ok em{color:#3df07a}
#lab .cn .ig.mis em{color:#ff6a5a}
#lab .cn .ig u{grid-column:1/-1;display:block;position:relative;height:4px;margin-top:2px;background:#06194a;box-shadow:inset 0 0 0 1px #14121f}
#lab .cn .ig u::after{content:'';position:absolute;left:0;top:0;bottom:0;width:var(--p);background:#ff6a5a}
#lab .cn .ig.ok u::after{background:repeating-linear-gradient(90deg,#3df07a 0 3px,#1d9a52 3px 4px)}
#lab .cn .done{padding:10px;text-align:center;font-size:.8em;letter-spacing:.1em;color:#ffcf6f}
#lab .cn .ft{display:flex;flex-direction:column;gap:5px}
#lab .cn .msg:empty{display:none}
#lab .cn .msg{min-height:1.3em;text-align:center;font-size:.74em;line-height:1.25;color:#74ecff}
