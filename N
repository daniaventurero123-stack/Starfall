/* ===== AVISOS: pixel art holográfico (botón de acción, mensajes, carteles de zona, cuenta atrás) ===== */
#act{--f:0%;font:700 14px/1 ui-monospace,Menlo,Consolas,monospace;letter-spacing:.16em;color:#d8f8ff;text-shadow:2px 2px 0 #06194a,-1px 0 #06194a,1px 0 #06194a;border:0;border-radius:0;padding:12px 18px;white-space:nowrap;
  background:linear-gradient(90deg,#ffcf6f var(--f),transparent var(--f)),repeating-linear-gradient(0deg,rgba(116,236,255,.1) 0 1px,transparent 1px 3px),linear-gradient(#1355c9,#06194a);
  box-shadow:0 -3px 0 #74ecff,0 3px 0 #74ecff,-3px 0 0 #74ecff,3px 0 0 #74ecff,inset 2px 2px 0 rgba(216,248,255,.28),inset -2px -2px 0 rgba(0,0,12,.4),0 7px 0 #06214f,0 0 18px #2f8cffbb}
