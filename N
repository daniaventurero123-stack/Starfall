.ov .hd .upb:active{background:rgba(255,194,61,.3)}
.ov .hd .upb.own,.ov .hd .upb:disabled{box-shadow:inset 0 0 0 1.5px #74ffb0,0 0 6px rgba(116,255,176,.4);cursor:default}
.ov .hd .upb::before,.ov .hd .upb::after{content:none!important;display:none!important}
#run{display:none;position:absolute;z-index:5;right:calc(18px + env(safe-area-inset-right,0px));bottom:calc(var(--ibr,170px) + env(safe-area-inset-bottom,0px));width:58px;height:58px;padding:0;align-items:center;justify-content:center;background:rgba(10,26,74,.72);border:3px solid #74ecff;border-radius:0;box-shadow:0 0 12px #2f8cff88;touch-action:none;-webkit-tap-highlight-color:transparent;user-select:none;-webkit-user-select:none}
