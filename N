const GRASS_T = .05, GRASS_B = .12;   // umbral del campo de césped y ancho de la franja de transición
// Se evalúan en orden: el primero cuya condición se cumple gana. Añadir un bioma = añadir una entrada.
const BIOMES = [
  { name:'Meseta basáltica', tile:'basalto',   when:(e)    => e > .70 },
  { name:'Lago',             tile:'agua',      when:(e, m, g, l) => l > 0 },
  { name:'Césped alienígena (violeta · ámbar · cobalto)', tile:'cesped',    when:(e, m, g) => g > GRASS_T },
  { name:'Pie de meseta',    tile:'escombros', when:(e)    => e > .63 },
  { name:'Cuenca helada',    tile:'hielo',     when:(e, m) => e < .32 && m > .48 },
  { name:'Llanura de polvo', tile:'polvo',     when:(e, m) => m < .40 },
  { name:'Campo de grava',   tile:'grava',     when:(e, m) => m > .60 },
  { name:'Regolito',         tile:'regolito',  when:() => true }
