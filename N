    const s = this.seed, x = bx + (vnoise(s + 5, bx / 22, by / 22) - .5) * 16, y = by + (vnoise(s + 6, bx / 22 + 9, by / 22 + 9) - .5) * 16;
    const [gv, lv] = this.grass(x, y);   // las manchas de césped aplanan las cotas altas para que ninguna meseta las parta
