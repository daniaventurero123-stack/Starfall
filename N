@media (max-height:560px){   /* pantallas horizontales bajas (móvil): todos los paneles de mesas (construcción, laboratorio, herramientas, satélite, minadora) aprovechan casi toda la pantalla en vez de quedarse en una altura fija que los recortaba */
  #lab{padding:3px}
  #lab .lbi{padding:6px;gap:5px}
  #lab .lbh img{height:2.2em}
  #lab .lbbody{height:auto!important;max-height:calc(100vh - 78px)!important;padding:5px!important}
  #lab .cn{height:calc(100vh - 100px);min-height:180px;gap:6px}
  #lab .rw{padding:5px 8px;gap:8px;grid-template-columns:2.2em 1fr auto}
  #lab .rw>img{width:2.2em;height:2.2em}
  #lab .rl{max-height:none;gap:5px}
  #lab .lbf{min-height:0;padding:6px 8px}
}
