#lab .cn .ft .pb{width:100%}
#lab .cn .ft .pb:disabled{opacity:1}
#lab .cn .bag{grid-column:1/-1;display:flex;align-items:center;gap:8px;min-width:0;padding:5px 8px;background:#06194a;box-shadow:inset 0 0 0 2px #14121f,inset 0 0 0 4px #0c3a8c}
#lab .cn .bl{flex:none;display:flex;flex-direction:column;gap:1px;font-size:.7em;letter-spacing:.1em;color:#74ecff}
#lab .cn .bl b{color:#ffcf6f}
#lab .cn .chs{flex:1;min-width:0;display:flex;gap:5px;overflow-x:auto;padding:3px 2px;scrollbar-width:thin}
#lab .cn .ch{position:relative;flex:none;width:30px;height:30px;display:grid;place-items:center;background:#0a1a4a;box-shadow:inset 0 0 0 2px #14121f,inset 0 0 0 3px #0c3a8c}
