  box-shadow:0 -2px 0 #ff7a5a,0 2px 0 #ff7a5a,-2px 0 0 #ff7a5a,2px 0 0 #ff7a5a,inset 5px 0 0 #ff7a5a,inset -2px -2px 0 rgba(0,0,0,.4),0 6px 0 #1c0612,0 0 14px #ff6a4caa}
