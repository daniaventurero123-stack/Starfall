  }
  // Manchas de césped (y los lagos que algunas alojan): cada celda de 48 bloques puede (según la seed) alojar una mancha elíptica de radio 16–30,
  // con borde irregular por ruido. Así no hay islotes diminutos y todo es determinista por coordenada (sin cortes entre chunks).
  grass(x, y) {
    const s = this.seed, C = 48, ci = Math.floor(x / C), cj = Math.floor(y / C);
    const edge = (vnoise(s + 708, x / 12, y / 12) - .5) * 10;
    let v = -1, L = -99;
    for (let j = cj - 1; j <= cj + 1; j++) for (let i = ci - 1; i <= ci + 1; i++) {
