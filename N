const CFG = { BLOCK:16, CHUNK:32, CW:16, CH:16, MAX_CACHE:90, GEN_PER_FRAME:1, ZONE_R:2.2 };   // ZONE_R: radio inicial (en chunks) de la zona de exploración habilitada
