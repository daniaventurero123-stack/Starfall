}
function exoW(px, py) {
  const E = EXO_G || exoGrid(), C = EXO_C, u = clamp(px / C - .5, 0, E.GW - 1.001), v = clamp(py / C - .5, 0, E.GH - 1.001), i = u | 0, j = v | 0, fx = u - i, fy = v - j, a = j * E.GW + i, g = E.g;
